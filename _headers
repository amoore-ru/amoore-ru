# Cloudflare Pages / Netlify
# CSS и JS без хэша в имени ВСЕГДА перепроверяем (ETag): раньше style.css был «immutable на год»,
# из-за чего браузеры держали старые стили (форма заявки без оформления, невидимые скелетоны новостей).
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/*.css
  Cache-Control: public, max-age=0, must-revalidate

/*.js
  Cache-Control: public, max-age=0, must-revalidate

/*.json
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Картинки меняются редко — кэшируем надолго (иконки PWA — хэш в имени файла)
/icons/icon-*
  Cache-Control: public, max-age=31536000, immutable

/icons/maskable-*
  Cache-Control: public, max-age=31536000, immutable

/icons/apple-touch-*
  Cache-Control: public, max-age=31536000, immutable

/icons/favicon-*
  Cache-Control: public, max-age=31536000, immutable

/icons/splash-*
  Cache-Control: public, max-age=31536000, immutable

# notify-* без хэша в имени — не immutable
/icons/notify-*
  Cache-Control: public, max-age=86400

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/manifest.json
  Content-Type: application/manifest+json
