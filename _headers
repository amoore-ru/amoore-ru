# Cloudflare Pages / Netlify
# CSS и JS без хэша в имени ВСЕГДА перепроверяем (ETag): раньше style.css был «immutable на год»,
# из-за чего браузеры держали старые стили (форма заявки без оформления, невидимые скелетоны новостей).
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/*.css
  Cache-Control: public, max-age=0, must-revalidate

/*.js
  Cache-Control: public, max-age=0, must-revalidate

/*.json
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Картинки меняются редко — кэшируем надолго
/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable
