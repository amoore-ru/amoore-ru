{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "amoore",
  "version": "6.1.0",
  "identifier": "ru.amoore.app",
  "build": { "frontendDist": "../www" },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "amoore",
        "url": "https://amoore.cc.cd",
        "fullscreen": true,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "android": { "minSdkVersion": 24 }
  }
}
